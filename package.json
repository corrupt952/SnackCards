{
  "name": "snack-cards",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.20.0",
  "version": "2026.02.1",
  "description": "Manage your Chrome Reading List in a side panel",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest",
    "format": "prettier --write \"entrypoints/**/*.{ts,tsx,js,jsx,json}\"",
    "postinstall": "wxt prepare"
  },
  "author": "K@zuki.",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wxt": "0.21.5"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
